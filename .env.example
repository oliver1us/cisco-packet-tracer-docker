# Copy to .env and adjust; Docker Compose reads .env automatically
PUID=1001
PGID=1001
# Remote desktop resolution
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080

# --- noVNC (browser, port 6080): HTTP Basic Auth ---
# The browser asks for these credentials at http://localhost:6080/vnc.html
HTTP_USER=admin
HTTP_PASSWORD=change-this-password

# --- Native VNC (port 5900) ---
# RFB supports only a password, max 8 characters; empty means no password
VNC_PASSWORD=
